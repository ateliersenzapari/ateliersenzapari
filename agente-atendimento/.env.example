# Porta local do servidor (Railway/Render definem PORT automaticamente em produção)
PORT=3000

# Anthropic (Claude) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Meta for Developers > seu App > WhatsApp > API Setup
# Token de acesso (temporário para testes ou permanente de uma System User)
META_WHATSAPP_TOKEN=
# Phone number ID do número de WhatsApp Business conectado
META_PHONE_NUMBER_ID=
# Token que você mesmo escolhe e usa também no cadastro do webhook na Meta
META_VERIFY_TOKEN=
# App Secret do App na Meta — usado para validar a assinatura das requisições do webhook (recomendado em produção)
META_APP_SECRET=

# Número de WhatsApp (com DDI, ex: 5581999999999) que recebe o aviso quando uma conversa é encaminhada para humano
HUMAN_HANDOFF_WHATSAPP_NUMBER=
